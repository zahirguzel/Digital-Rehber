# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/digitalrehber

# Database
DB_HOST=localhost
DB_NAME=hatayweb
DB_USER=root
DB_PASS=

# Redis (Optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email (E-posta Gönderim Ayarları)
# APP_ENV=development iken mailler loglanır, gerçek mail atılmaz. Canlıya çıkarken APP_ENV=production yapmayı unutmayın!
# MAIL_HOST: SMTP sunucu adresiniz (ör: smtp.hostinger.com veya smtp.gmail.com)
MAIL_HOST=smtp.gmail.com
# MAIL_PORT: Genelde SSL için 465, TLS için 587 kullanılır.
MAIL_PORT=587
# MAIL_USER: E-posta adresiniz (SMTP girişi için)
MAIL_USER=your_email@gmail.com
# MAIL_PASS: E-posta şifreniz (Gmail kullanıyorsanız "Uygulama Şifresi" almanız gerekir)
MAIL_PASS=your_app_password
# MAIL_FROM: Maillerin hangi adresten gidiyormuş gibi görüneceği (Genelde MAIL_USER ile aynı olur)
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Kibris Rehberim"
# ADMIN_EMAIL: Site üzerinden gönderilen tüm formların (İletişim, İşletme Başvuru vb.) geleceği YÖNETİCİ maili.
ADMIN_EMAIL=admin@example.com

# Telegram (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Session
SESSION_LIFETIME=7200
SESSION_COOKIE_SECURE=false

# Upload
UPLOAD_MAX_SIZE=5242880

# Cache
CACHE_DRIVER=file

# Logging
LOG_LEVEL=debug
