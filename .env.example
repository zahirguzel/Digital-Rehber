# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/digitalrehber

# Database
DB_HOST=localhost
DB_NAME=hatayweb
DB_USER=root
DB_PASS=

# Redis (Optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Kibris Rehberim"

# Telegram (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Session
SESSION_LIFETIME=7200
SESSION_COOKIE_SECURE=false

# Upload
UPLOAD_MAX_SIZE=5242880

# Cache
CACHE_DRIVER=file

# Logging
LOG_LEVEL=debug
