{
    "name": "kibris-rehber/platform",
    "description": "Professional local business directory platform",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "phpmailer/phpmailer": "^6.8",
        "ezyang/htmlpurifier": "^4.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "core/",
            "App\\Models\\": "models/",
            "App\\Controllers\\": "controllers/",
            "App\\Middleware\\": "middleware/",
            "App\\Services\\": "services/",
            "App\\Helpers\\": "helpers/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
